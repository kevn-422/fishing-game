                                    <button onclick="app.submitAnswer(${idx})" 
                                        ${isEliminated ? 'disabled' : ''}
                                        class="w-full p-4 rounded-2xl bg-slate-800/80 hover:bg-purple-900/40 border border-slate-700 hover:border-purple-500/50 text-left font-medium text-slate-200 hover:text-white transition flex items-center justify-between group ${isEliminated ? 'opacity-20 line-through cursor-not-allowed' : ''}">
                                        <span><strong class="text-purple-400 mr-2">${idx + 1}.</strong>${opt}</span>
                                        <i class="fa-regular fa-circle text-slate-600 group-hover:text-purple-400 transition"></i>
                                    </button>
                                `;
                            }).join('')}
                        </div>
                    </div>
                `;
            }

            startTimer() {
                clearInterval(this.quizState.timer);
                this.quizState.timeLeft = 15;

                const updateUI = () => {
                    const timerNum = document.getElementById('quiz-timer-num');
                    const timerBar = document.getElementById('quiz-timer-bar');
                    if (timerNum && timerBar) {
                        timerNum.innerText = `${this.quizState.timeLeft}초`;
                        const pct = (this.quizState.timeLeft / 15) * 100;
                        timerBar.style.width = `${pct}%`;
                    }
                };

                updateUI();
                this.quizState.timer = setInterval(() => {
                    this.quizState.timeLeft--;
                    sound.playTick();
                    updateUI();

                    if (this.quizState.timeLeft <= 0) {
                        clearInterval(this.quizState.timer);
                        this.handleTimeOut();
                    }
                }, 1000);
            }

            handleTimeOut() {
                if (this.quizState.activeBuffs.shield) {
                    this.quizState.activeBuffs.shield = false;
                    this.showToast('오답 방어막으로 시간 초과를 회피했습니다!', 'fa-shield-cat');
                    this.startTimer();
                    return;
                }
                sound.playWrong();
                this.showAnswerFeedback(false, null, '제한시간 초과!');
            }

            submitAnswer(chosenIdx) {
                clearInterval(this.quizState.timer);
                const q = this.quizState.questions[this.quizState.currentIndex];
                const isCorrect = (chosenIdx === q.a);

                if (isCorrect) {
                    sound.playCorrect();
                    confetti({ particleCount: 30, spread: 60, origin: { y: 0.7 } });
                    
                    let earned = 50;
                    if (this.quizState.activeBuffs.doublePoint) {
                        earned *= 2;
                    }
                    this.quizState.score += earned;
                    this.showAnswerFeedback(true, chosenIdx, `정답입니다! (+${earned} P)`);
                } else {
                    if (this.quizState.activeBuffs.shield) {
                        this.quizState.activeBuffs.shield = false;
                        this.showToast('오답 방어막이 발동하여 기회를 보전했습니다!', 'fa-shield-cat');
                        this.startTimer();
                        return;
                    }
                    sound.playWrong();
                    this.showAnswerFeedback(false, chosenIdx, '아쉽네요, 오답입니다!');
                }
            }

            showAnswerFeedback(isCorrect, chosenIdx, msg) {
                const q = this.quizState.questions[this.quizState.currentIndex];
                const container = document.getElementById('options-container');

                if (container) {
                    const buttons = container.querySelectorAll('button');
                    buttons.forEach((btn, idx) => {
                        btn.disabled = true;
                        if (idx === q.a) {
                            btn.className = 'w-full p-4 rounded-2xl bg-emerald-600/30 border-2 border-emerald-500 text-left font-bold text-white flex items-center justify-between';
                        } else if (idx === chosenIdx && !isCorrect) {
                            btn.className = 'w-full p-4 rounded-2xl bg-rose-600/30 border-2 border-rose-500 text-left font-bold text-white flex items-center justify-between';
                        }
                    });
                }

                const appElem = document.getElementById('app-container').firstElementChild;
                const modal = document.createElement('div');
                modal.className = 'mt-6 p-4 rounded-2xl bg-slate-900 border border-slate-700 animate-fade-in';
                modal.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-bold ${isCorrect ? 'text-emerald-400' : 'text-rose-400'}">${msg}</span>
                    </div>
                    <p class="text-xs text-slate-300 mb-4">💡 <strong>해설:</strong> ${q.exp}</p>
                    <button onclick="app.nextQuestion()" class="w-full py-3 rounded-xl bg-purple-600 hover:bg-purple-500 font-bold text-white shadow-lg transition">
                        ${this.quizState.currentIndex < this.quizState.questions.length - 1 ? '다음 문제' : '결과 확인하기'}
                    </button>
                `;
                appElem.appendChild(modal);
            }

            nextQuestion() {
                this.quizState.currentIndex++;
                this.quizState.eliminatedOpts = [];
                if (this.quizState.currentIndex < this.quizState.questions.length) {
                    this.renderQuizScreen();
                    this.startTimer();
                } else {
                    this.finishQuizSession();
                }
            }

            useItemInQuiz(itemKey) {
                if ((this.state.inventory[itemKey] || 0) <= 0) {
                    this.showToast('아이템 수량이 부족합니다. 상점에서 구입하세요!', 'fa-store');
                    return;
                }

                if (itemKey === 'timeBoost') {
                    this.state.inventory.timeBoost--;
                    this.quizState.timeLeft += 10;
                    this.showToast('시간이 10초 연장되었습니다!', 'fa-stopwatch');
                } else if (itemKey === 'hint') {
                    const q = this.quizState.questions[this.quizState.currentIndex];
                    const wrongOpts = [0, 1, 2, 3].filter(idx => idx !== q.a);
                    wrongOpts.sort(() => Math.random() - 0.5);
                    this.quizState.eliminatedOpts = wrongOpts.slice(0, 2);
                    this.state.inventory.hint--;
                    this.showToast('오답 보기 2개가 제거되었습니다!', 'fa-lightbulb');
                    this.renderQuizScreen();
                } else if (itemKey === 'doublePoint') {
                    if (this.quizState.activeBuffs.doublePoint) return;
                    this.state.inventory.doublePoint--;
                    this.quizState.activeBuffs.doublePoint = true;
                    this.showToast('2배 점수 버프가 활성화되었습니다!', 'fa-bolt');
                } else if (itemKey === 'shield') {
                    if (this.quizState.activeBuffs.shield) return;
                    this.state.inventory.shield--;
                    this.quizState.activeBuffs.shield = true;
                    this.showToast('오답 방어막이 활성화되었습니다!', 'fa-shield-cat');
                }

                this.saveState();
            }

            finishQuizSession() {
                sound.playFanfare();
                confetti({ particleCount: 100, spread: 100, origin: { y: 0.5 } });

                const totalQ = this.quizState.questions.length;
                const score = this.quizState.score;

                let starsEarned = 1;
                if (score >= totalQ * 40) starsEarned = 3;
                else if (score >= totalQ * 25) starsEarned = 2;

                const key = `${this.quizState.catId}_${this.quizState.stageNum}`;
                const prevStars = this.state.stars[key] || 0;
                if (starsEarned > prevStars) {
                    this.state.stars[key] = starsEarned;
                }

                this.state.points += score;
                this.saveState();

                const container = document.getElementById('app-container');
                container.innerHTML = `
                    <div class="max-w-md mx-auto glass rounded-3xl p-8 text-center border border-slate-700 shadow-2xl">
                        <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-amber-400 to-orange-500 mx-auto flex items-center justify-center text-white text-3xl shadow-xl mb-4">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <h2 class="title-font text-3xl font-bold text-white mb-2">Stage ${this.quizState.stageNum} 클리어!</h2>
                        <p class="text-slate-400 text-sm mb-6">5문제를 모두 멋지게 해결하셨습니다!</p>

                        <div class="flex justify-center gap-2 text-3xl text-amber-400 mb-6">
                            <i class="fa-${starsEarned >= 1 ? 'solid' : 'regular'} fa-star"></i>
                            <i class="fa-${starsEarned >= 2 ? 'solid' : 'regular'} fa-star"></i>
                            <i class="fa-${starsEarned >= 3 ? 'solid' : 'regular'} fa-star"></i>
                        </div>

                        <div class="bg-slate-900/80 rounded-2xl p-4 border border-slate-800 mb-6 space-y-2 text-sm">
                            <div class="flex justify-between text-slate-400">
                                <span>획득 포인트</span>
                                <span class="text-amber-300 font-bold">+${score} P</span>
                            </div>
                            <div class="flex justify-between text-slate-400">
                                <span>총 보유 포인트</span>
                                <span class="text-white font-bold">${this.state.points} P</span>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <button onclick="app.navTo('stagemap', { catId: '${this.quizState.catId}' })" class="flex-1 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition">
                                스테이지 지도
                            </button>
                            <button onclick="app.navTo('home')" class="flex-1 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold transition">
                                홈으로
                            </button>
                        </div>
                    </div>
                `;
            }

            renderShopView() {
                return `
                    <div class="max-w-4xl mx-auto">
                        <button onclick="app.navTo('home')" class="mb-6 flex items-center gap-2 text-slate-400 hover:text-white transition text-sm">
                            <i class="fa-solid fa-arrow-left"></i> 홈으로 돌아가기
                        </button>

                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <h2 class="title-font text-3xl font-bold text-amber-300 flex items-center gap-2">
                                    <i class="fa-solid fa-store"></i> 포인트 아이템 상점
                                </h2>
                                <p class="text-slate-400 text-sm mt-1">퀴즈 풀이에 유리한 아이템과 멋진 칭호를 구매하세요.</p>
                            </div>
                            <div class="px-4 py-2 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 font-bold">
                                <i class="fa-solid fa-coins mr-1"></i> ${this.state.points} P
                            </div>
                        </div>

                        <h3 class="title-font text-xl font-bold text-white mb-4">파워업 아이템</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
                            ${SHOP_ITEMS.map(item => `
                                <div class="glass-card rounded-2xl p-5 border border-slate-700 flex justify-between items-center">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 text-xl">
                                            <i class="fa-solid ${item.icon}"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-white text-sm">${item.name}</h4>
                                            <p class="text-xs text-slate-400 mt-0.5">${item.desc}</p>
                                            <span class="text-xs text-amber-400 font-bold mt-1 inline-block">${item.price} P</span>
                                        </div>
                                    </div>
                                    <button onclick="app.buyShopItem('${item.id}')" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md transition">
                                        구매
                                    </button>
                                </div>
                            `).join('')}
                        </div>

                        <h3 class="title-font text-xl font-bold text-white mb-4">한정판 칭호 상점</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            ${TITLES_DATA.map(t => {
                                const isOwned = this.state.ownedTitles.includes(t.id);
                                return `
                                    <div class="glass-card rounded-2xl p-5 border border-slate-700 flex flex-col justify-between">
                                        <div>
                                            <div class="flex items-center justify-between mb-3">
                                                <i class="fa-solid ${t.icon} text-2xl text-purple-400"></i>
                                                <span class="text-xs font-bold ${isOwned ? 'text-emerald-400' : 'text-amber-400'}">
                                                    ${isOwned ? '보유 중' : `${t.price} P`}
                                                </span>
                                            </div>
                                            <h4 class="font-bold text-white text-base mb-1">${t.name}</h4>
                                            <p class="text-xs text-slate-400">${t.desc}</p>
                                        </div>
                                        <div class="mt-4 pt-3 border-t border-slate-800">
                                            ${isOwned ? `
                                                <span class="text-xs text-emerald-400 font-semibold"><i class="fa-solid fa-check"></i> 이미 구매함</span>
                                            ` : `
                                                <button onclick="app.buyTitle('${t.id}')" class="w-full py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition">
                                                    칭호 구매하기
                                                </button>
                                            `}
                                        </div>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    </div>
                `;
            }

            buyShopItem(itemId) {
                const item = SHOP_ITEMS.find(i => i.id === itemId);
                if (!item) return;

                if (this.state.points < item.price) {
                    this.showToast('포인트가 부족합니다!', 'fa-triangle-exclamation');
                    return;
                }

                this.state.points -= item.price;
                this.state.inventory[item.key] = (this.state.inventory[item.key] || 0) + 1;
                this.saveState();
                this.showToast(`${item.name} 아이템을 구매했습니다!`, 'fa-bag-shopping');
                this.navTo('shop');
            }

            buyTitle(titleId) {
                const title = TITLES_DATA.find(t => t.id === titleId);
                if (!title) return;

                if (this.state.ownedTitles.includes(titleId)) return;

                if (this.state.points < title.price) {
                    this.showToast('포인트가 부족합니다!', 'fa-triangle-exclamation');
                    return;
                }

                this.state.points -= title.price;
                this.state.ownedTitles.push(titleId);
                this.saveState();
                this.showToast(`칭호 [${title.name}]를 습득했습니다!`, 'fa-award');
                this.navTo('shop');
            }

            renderInventoryView() {
                return `
                    <div class="max-w-4xl mx-auto">
                        <button onclick="app.navTo('home')" class="mb-6 flex items-center gap-2 text-slate-400 hover:text-white transition text-sm">
                            <i class="fa-solid fa-arrow-left"></i> 홈으로 돌아가기
                        </button>

                        <h2 class="title-font text-3xl font-bold text-purple-300 mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-medal"></i> 내 칭호 & 아이템 보관함
                        </h2>
                        <p class="text-slate-400 text-sm mb-8">획득한 칭호를 장착하여 프로필에 표시해 보세요.</p>

                        <h3 class="title-font text-xl font-bold text-white mb-4">보유한 칭호 목록</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
                            ${this.state.ownedTitles.map(tId => {
                                const title = TITLES_DATA.find(t => t.id === tId);
                                if (!title) return '';
                                const isEquipped = this.state.equippedTitle === title.name;

                                return `
                                    <div class="glass-card rounded-2xl p-5 border border-slate-700 flex flex-col justify-between ${isEquipped ? 'ring-2 ring-purple-500' : ''}">
                                        <div>
                                            <div class="flex items-center justify-between mb-3">
                                                <i class="fa-solid ${title.icon} text-2xl text-purple-400"></i>
                                                ${isEquipped ? '<span class="text-xs bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2.5 py-1 rounded-full font-bold">장착 중</span>' : ''}
                                            </div>
                                            <h4 class="font-bold text-white text-base mb-1">${title.name}</h4>
                                            <p class="text-xs text-slate-400">${title.desc}</p>
                                        </div>
                                        <div class="mt-4 pt-3 border-t border-slate-800">
                                            ${!isEquipped ? `
                                                <button onclick="app.equipTitle('${title.name}')" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-purple-300 font-bold text-xs border border-slate-700 transition">
                                                    착용하기
                                                </button>
                                            ` : `
                                                <span class="text-xs text-slate-500 font-medium">현재 프로필에 표시 중</span>
                                            `}
                                        </div>
                                    </div>
                                `;
                            }).join('')}
                        </div>

                        <h3 class="title-font text-xl font-bold text-white mb-4">소모성 아이템 보유 수량</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                            <div class="glass p-4 rounded-2xl text-center border border-slate-800">
                                <i class="fa-solid fa-stopwatch text-2xl text-cyan-400 mb-2"></i>
                                <div class="text-xs text-slate-400">타이머 연장</div>
                                <div class="text-lg font-bold text-white mt-1">${this.state.inventory.timeBoost || 0} 개</div>
                            </div>
                            <div class="glass p-4 rounded-2xl text-center border border-slate-800">
                                <i class="fa-solid fa-lightbulb text-2xl text-amber-400 mb-2"></i>
                                <div class="text-xs text-slate-400">정답 힌트</div>
                                <div class="text-lg font-bold text-white mt-1">${this.state.inventory.hint || 0} 개</div>
                            </div>
                            <div class="glass p-4 rounded-2xl text-center border border-slate-800">
                                <i class="fa-solid fa-bolt text-2xl text-emerald-400 mb-2"></i>
                                <div class="text-xs text-slate-400">2배 점수 버프</div>
                                <div class="text-lg font-bold text-white mt-1">${this.state.inventory.doublePoint || 0} 개</div>
                            </div>
                            <div class="glass p-4 rounded-2xl text-center border border-slate-800">
                                <i class="fa-solid fa-shield-cat text-2xl text-pink-400 mb-2"></i>
                                <div class="text-xs text-slate-400">오답 방어막</div>
                                <div class="text-lg font-bold text-white mt-1">${this.state.inventory.shield || 0} 개</div>
                            </div>
                        </div>
                    </div>
                `;
            }

            equipTitle(titleName) {
                this.state.equippedTitle = titleName;
                this.saveState();
                this.showToast(`칭호가 [${titleName}](으)로 변경되었습니다!`, 'fa-award');
                this.navTo('inventory');
            }

            openCustomModal() {
                const modal = document.getElementById('custom-modal');
                const select = document.getElementById('modal-category');
                select.innerHTML = CATEGORIES_DATA.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
                modal.classList.remove('hidden');
            }

            closeCustomModal() {
                document.getElementById('custom-modal').classList.add('hidden');
            }

            handleSaveCustomQuiz(e) {
                e.preventDefault();
                const catId = document.getElementById('modal-category').value;
                const tag = document.getElementById('modal-tag').value;
                const q = document.getElementById('modal-question').value;
                const opts = [
                    document.getElementById('modal-opt-0').value,
                    document.getElementById('modal-opt-1').value,
                    document.getElementById('modal-opt-2').value,
                    document.getElementById('modal-opt-3').value
                ];
                const a = parseInt(document.getElementById('modal-answer').value, 10);
                const exp = document.getElementById('modal-explanation').value;

                if (!this.state.customQuizzes[catId]) {
                    this.state.customQuizzes[catId] = [];
                }

                this.state.customQuizzes[catId].push({ tag, q, opts, a, exp });
                this.saveState();
                this.closeCustomModal();
                this.showToast('나만의 퀴즈가 성공적으로 등록되었습니다!', 'fa-circle-check');
            }
        }

        let app;
        window.addEventListener('DOMContentLoaded', () => {
            app = new QuizApp();
            app.navTo('home');
        });
    </script>
</body>
</html>
